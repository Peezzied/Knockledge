{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FirestoreNoteDocument",
  "description": "Validation schema for note documents under /users/{userId}/notes/{noteId}",
  "type": "object",
  "required": [
    "id",
    "userId",
    "title",
    "createdAtEpochMs",
    "updatedAtEpochMs",
    "audio"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "createdAtEpochMs": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAtEpochMs": {
      "type": "integer",
      "minimum": 0
    },
    "audio": {
      "type": "object",
      "required": ["durationMs", "sampleRate", "triggerType"],
      "properties": {
        "remoteUrl": {
          "type": ["string", "null"]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1000
        },
        "sampleRate": {
          "type": "integer",
          "enum": [16000]
        },
        "triggerType": {
          "type": "string",
          "enum": ["GESTURE", "MANUAL"]
        }
      }
    },
    "transcript": {
      "type": ["object", "null"],
      "properties": {
        "fullText": {
          "type": "string"
        },
        "sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["speaker", "startTimeMs", "endTimeMs", "text"],
            "properties": {
              "speaker": { "type": "string" },
              "startTimeMs": { "type": "integer", "minimum": 0 },
              "endTimeMs": { "type": "integer", "minimum": 0 },
              "text": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        },
        "isDiarized": { "type": "boolean" },
        "detectedLanguage": { "type": "string" },
        "engineType": {
          "type": "string",
          "enum": ["CLOUD_FIREBASE_AI", "LOCAL_WHISPER"]
        }
      }
    },
    "summary": {
      "type": ["object", "null"],
      "properties": {
        "executiveSummary": { "type": "string" },
        "keyPoints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "chapterMarkers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["startTimeMs", "title", "keyBullets"],
            "properties": {
              "startTimeMs": { "type": "integer", "minimum": 0 },
              "title": { "type": "string" },
              "keyBullets": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "generationMode": {
          "type": "string",
          "enum": ["CLOUD_FIREBASE_AI", "LOCAL_ON_DEVICE"]
        }
      }
    }
  }
}
